# ==============================================================================
# STERN-X Unified Backend Environment Configuration
# Standardized exclusively on PostgreSQL (Local PostgreSQL 18 on Port 5433)
# ==============================================================================

# Server Environment & Port (5001 ensures no conflicts with other local dev servers on 5000)
NODE_ENV=development
PORT=5001
API_VERSION=1.0.0
SERVICE_NAME=sternx-unified-backend

# CORS Configuration
# Comma-separated list of authorized origins (defaults allow local Vite development on port 3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Local PostgreSQL Database Persistence (Windows Service PostgreSQL 18 on port 5433)
# Target database: sternkraft_db
# Replace <YOUR_POSTGRESQL_PASSWORD> with your local postgres superuser password
DATABASE_URL="postgresql://postgres:<YOUR_POSTGRESQL_PASSWORD>@localhost:5433/sternkraft_db?schema=public"
