# ==============================================================================
# STERN-X Unified Environment Configuration (Docker Compose)
# ==============================================================================
# Copy this file to .env before starting the Docker Compose stack:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL credentials used internally within the Docker bridge network.
# Database port is not published to the host for security.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=sternkraft_db

# ------------------------------------------------------------------------------
# 2. Unified Backend Service Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5001

# Authorized CORS origins (comma-separated).
# Non-browser requests (ESP32 firmware, curl, CLI) are permitted regardless.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:80,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173,http://127.0.0.1:80,http://localhost:5001

# Database Initialization Controls:
# AUTO_DB_INIT: If true, safely synchronizes Prisma schema to PostgreSQL on container startup.
# Never drops tables, resets migrations, or causes data loss.
AUTO_DB_INIT=true

# AUTO_DB_SEED: If true, executes demo data seeding on container startup.
# Keep false by default to prevent unexpected record overwrites.
AUTO_DB_SEED=false

# ------------------------------------------------------------------------------
# 3. Frontend Web Service & Nginx Reverse Proxy Configuration
# ------------------------------------------------------------------------------
# Host port mapping for accessing the frontend application in your browser.
FRONTEND_PORT=3000

# Build-time Vite base URLs for same-origin Nginx reverse proxy.
# These map all frontend browser calls to /api/* via Nginx.
VITE_API_BASE_URL=/api
VITE_FLOOD_API_BASE_URL=/api/flood
VITE_HEALTH_URL=/api/health
